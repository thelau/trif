{
  "name": "trif",
  "version": "1.0.0",
  "description": "Audio visualizer web application",
  "private": true,
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "mkdir -p dist && cp index.html dist/ && cp -r assets dist/ && postcss dist/assets/css/style.css --replace --use cssnano",
    "preview": "vite preview",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "devDependencies": {
    "cssnano": "^7.1.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "vite": "^6.4.1"
  },
  "keywords": [
    "audio",
    "visualizer",
    "web-audio"
  ],
  "author": "",
  "license": "ISC",
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  }
}
