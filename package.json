{
  "name": "trif",
  "version": "1.0.0",
  "description": "Audio visualizer web application",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "mkdir -p dist && cp index.html dist/ && cp -r assets dist/ && postcss dist/assets/css/style.css --replace --use cssnano",
    "preview": "vite preview",
    "lint": "eslint --config .config/.eslintrc.cjs assets/js/index.js && stylelint --config .config/.stylelintrc.cjs assets/css/style.css",
    "lint:fix": "eslint --config .config/.eslintrc.cjs --fix assets/js/index.js && stylelint --config .config/.stylelintrc.cjs --fix assets/css/style.css",
    "test": "jest --passWithNoTests",
    "audit": "lighthouse-ci http://localhost:4173 --performance=80 --best-practices=90",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "cssnano": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lighthouse-ci": "^1.13.1",
    "lint-staged": "^15.5.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "vite": "^7.3.1"
  },
  "lint-staged": {
    "*.js": ["eslint", "jest --passWithNoTests"],
    "*.css": ["stylelint"]
  },
  "keywords": [
    "audio",
    "visualizer",
    "web-audio"
  ],
  "author": "",
  "license": "ISC",
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  }
}
