{
  "name": "trif",
  "version": "1.0.0",
  "description": "Audio visualizer web application",
  "private": true,
  "engines": {
    "node": ">=18.20.0"
  },
    "scripts": {
    "dev": "npm-run-all --parallel sass:watch dev:https",
    "dev:server": "live-server --port=4000 --open=/ --quiet",
    "dev:https": "local-https-server --port=4000 --cert=cert.pem --key=key.pem --open=/ --quiet",
    "sass": "sass assets/scss:assets/css --style=compressed --no-source-map",
    "sass:watch": "sass assets/scss:assets/css --style=compressed --watch",
    "build": "npm run sass",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "devDependencies": {
    "sass": "^1.77.0",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5"
  },
  "keywords": [
    "audio",
    "visualizer",
    "web-audio"
  ],
  "author": "",
  "license": "ISC"
}
