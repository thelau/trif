{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "numberOfRuns": 1,
      "chromeFlags": ["--headless", "--no-sandbox", "--disable-dev-shm-usage"]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.8}],
        "categories:best-practices": ["error", {"minScore": 0.9}]
      }
    }
  }
}